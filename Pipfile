[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
sqlalchemy = "*"
email-validator = "*"
python-jose = "*"
pytest = "*"
httpx = "*"
uvicorn = "*"
bcrypt = "*"
python-dotenv = "*"
python-multipart = "*"
google-auth = "*"
requests = "*"
psycopg2-binary = "*"
slowapi = "*"

[dev-packages]

[requires]
python_version = "3.14"

[scripts]
# --host 0.0.0.0: por defecto uvicorn solo escucha en 127.0.0.1
# (loopback), así que un iPhone físico en la misma red no podía llegar
# al backend aunque apuntara a la IP del Mac — el puerto ni siquiera
# aceptaba la conexión desde fuera del propio Mac.
dev = "uvicorn app.main:app --reload --host 0.0.0.0"
test = "pytest -v"
