# Copia este archivo a ".env" y rellena los valores reales — "sin secretos" es
# lo único que hace seguro subir ESTE archivo (.env.example) al repo; ".env" en
# sí sigue sin subirse nunca (ver .gitignore).

# --- Postgres (servicio "db" en docker-compose.yml) ---
POSTGRES_USER=rydr
POSTGRES_PASSWORD=cambia-esto-por-algo-seguro
POSTGRES_DB=rydr

# Compuesta a partir de los tres de arriba, apuntando al servicio "db" por
# la red interna de Docker Compose — docker-compose.yml ya la arma solo
# para el contenedor "backend"; esta línea es solo para tenerla a mano si
# alguna vez hace falta correr el backend fuera de Compose contra el
# mismo Postgres.
DATABASE_URL=postgresql://rydr:cambia-esto-por-algo-seguro@db:5432/rydr

# --- Auth ---
# Genera uno de verdad, no dejes el de ejemplo: `openssl rand -hex 32`
SECRET_KEY=cambia-esto-por-una-clave-generada-de-verdad
ALGORITHM=HS256

# Client ID de tipo iOS de Google Cloud Console (mismo que usa la app,
# ver ios-native-nav/project.yml → GIDClientID) — el backend lo usa para
# verificar que el ID token del login con Google es de verdad para esta app.
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# --- Email transaccional (restablecer contraseña) ---
# API key de https://resend.com (plan gratis: 3.000 emails/mes). Sin
# esto, el código de restablecer contraseña se genera igual pero nunca
# llega a mandarse por email (ver app/shared/email.py).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rydr <onboarding@resend.dev>

# --- CORS ---
# Orígenes con permiso, separados por comas — vacío por defecto (una app
# nativa no lo necesita; esto es solo por si algún día hay un cliente
# web). Ej: ALLOWED_ORIGINS=https://app.tudominio.com
ALLOWED_ORIGINS=

# --- Caddy (proxy inverso / HTTPS) ---
# El dominio tiene que apuntar YA (registro A/AAAA) a la IP de este
# servidor antes de arrancar, o Caddy no consigue el certificado. Para
# probar en local sin dominio real, usa "localhost" — Caddy emite un
# certificado propio autofirmado para ese caso concreto, sin tocar
# Let's Encrypt.
DOMAIN=api.tudominio.com
